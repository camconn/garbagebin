{
  "ignore_headers": [],
  "ignore_xml": [],
  "steps": [
    {"name": "create bucket", "method": "PUT"},
    {"name": "head bucket", "method": "HEAD"},
    {"name": "create existing bucket", "method": "PUT"},
    {"name": "get missing bucket", "method": "GET", "bucket": "{bucket}-missing", "key": "x"},

    {"name": "put with metadata", "method": "PUT", "key": "dir/a.txt", "body": "hello, differential world\n",
     "headers": {"Content-Type": "text/plain", "Cache-Control": "no-cache", "x-amz-meta-color": "blue"},
     "capture": {"etag_a": {"header": "ETag"}}},
    {"name": "put default content-type", "method": "PUT", "key": "dir/b.bin", "body": {"random": 1024, "seed": 1}},
    {"name": "put nested", "method": "PUT", "key": "dir/sub/c.txt", "body": "c"},
    {"name": "put top", "method": "PUT", "key": "top.txt", "body": "top"},
    {"name": "put key with ampersand", "method": "PUT", "key": "odd/a&b.txt", "body": "amp"},
    {"name": "put key with angle", "method": "PUT", "key": "odd/a<b.txt", "body": "lt"},
    {"name": "put unicode key", "method": "PUT", "key": "odd/ünïcødé ☃.txt", "body": "snow"},

    {"name": "head", "method": "HEAD", "key": "dir/a.txt"},
    {"name": "get", "method": "GET", "key": "dir/a.txt"},
    {"name": "get default content-type", "method": "GET", "key": "dir/b.bin"},
    {"name": "head missing key", "method": "HEAD", "key": "nope"},
    {"name": "get missing key", "method": "GET", "key": "nope"},
    {"name": "range get", "method": "GET", "key": "dir/a.txt", "headers": {"Range": "bytes=7-18"}},
    {"name": "range open-ended", "method": "GET", "key": "dir/a.txt", "headers": {"Range": "bytes=0-"}},
    {"name": "range suffix", "method": "GET", "key": "dir/a.txt", "headers": {"Range": "bytes=-5"}},
    {"name": "range unsatisfiable", "method": "GET", "key": "dir/a.txt", "headers": {"Range": "bytes=1000-2000"}},
    {"name": "if-none-match hit", "method": "GET", "key": "dir/a.txt", "headers": {"If-None-Match": "{etag_a}"}},
    {"name": "if-match miss", "method": "GET", "key": "dir/a.txt", "headers": {"If-Match": "\"0000\""}},

    {"name": "list v2 prefix+delimiter", "method": "GET", "query": {"list-type": "2", "prefix": "dir/", "delimiter": "/"}},
    {"name": "list v2 root delimiter", "method": "GET", "query": {"list-type": "2", "delimiter": "/"}},
    {"name": "list v2 paginated", "method": "GET", "query": {"list-type": "2", "max-keys": "2"},
     "capture": {"token": {"xml": "NextContinuationToken"}}},
    {"name": "list v2 continuation", "method": "GET", "query": {"list-type": "2", "max-keys": "2", "continuation-token": "{token}"}},
    {"name": "list v2 start-after", "method": "GET", "query": {"list-type": "2", "start-after": "dir/b.bin"}},
    {"name": "list v2 encoding-type=url", "method": "GET", "query": {"list-type": "2", "prefix": "odd/", "encoding-type": "url"}},
    {"name": "list v2 xml escaping", "method": "GET", "query": {"list-type": "2", "prefix": "odd/"}},
    {"name": "list v1", "method": "GET", "query": {"delimiter": "/"}},
    {"name": "list v1 marker", "method": "GET", "query": {"marker": "dir/a.txt", "max-keys": "2"}},

    {"name": "copy", "method": "PUT", "key": "copy/a.txt", "headers": {"x-amz-copy-source": "/{bucket}/dir/a.txt"}},
    {"name": "head copy", "method": "HEAD", "key": "copy/a.txt"},
    {"name": "copy url-encoded source", "method": "PUT", "key": "copy/snow.txt",
     "headers": {"x-amz-copy-source": "/{bucket}/odd/%C3%BCn%C3%AFc%C3%B8d%C3%A9%20%E2%98%83.txt"}},
    {"name": "copy replace metadata", "method": "PUT", "key": "copy/a.txt",
     "headers": {"x-amz-copy-source": "/{bucket}/copy/a.txt", "x-amz-metadata-directive": "REPLACE",
                 "Content-Type": "application/json", "x-amz-meta-color": "red"}},
    {"name": "head after replace", "method": "HEAD", "key": "copy/a.txt"},
    {"name": "same-key copy without replace", "method": "PUT", "key": "copy/a.txt",
     "headers": {"x-amz-copy-source": "/{bucket}/copy/a.txt"}},

    {"name": "multipart create", "method": "POST", "key": "big.bin", "query": {"uploads": ""},
     "headers": {"Content-Type": "application/x-test"}, "capture": {"upload_id": {"xml": "UploadId"}}},
    {"name": "upload part 1", "method": "PUT", "key": "big.bin", "query": {"partNumber": "1", "uploadId": "{upload_id}"},
     "body": {"random": 5242880, "seed": 11}, "capture": {"etag1": {"header": "ETag"}}},
    {"name": "upload part 2", "method": "PUT", "key": "big.bin", "query": {"partNumber": "2", "uploadId": "{upload_id}"},
     "body": {"random": 1000, "seed": 12}, "capture": {"etag2": {"header": "ETag"}}},
    {"name": "list parts", "method": "GET", "key": "big.bin", "query": {"uploadId": "{upload_id}"}},
    {"name": "list multipart uploads", "method": "GET", "query": {"uploads": ""}},
    {"name": "complete with bad part", "method": "POST", "key": "big.bin", "query": {"uploadId": "{upload_id}"},
     "body": "<CompleteMultipartUpload><Part><PartNumber>1</PartNumber><ETag>\"00000000000000000000000000000000\"</ETag></Part></CompleteMultipartUpload>"},
    {"name": "complete", "method": "POST", "key": "big.bin", "query": {"uploadId": "{upload_id}"}, "ignore_xml": ["Location"],
     "body": "<CompleteMultipartUpload><Part><PartNumber>1</PartNumber><ETag>{etag1}</ETag></Part><Part><PartNumber>2</PartNumber><ETag>{etag2}</ETag></Part></CompleteMultipartUpload>"},
    {"name": "head multipart", "method": "HEAD", "key": "big.bin"},
    {"name": "head multipart part 1", "method": "HEAD", "key": "big.bin", "query": {"partNumber": "1"}},
    {"name": "multipart too small", "method": "POST", "key": "small.bin", "query": {"uploads": ""},
     "capture": {"upload_id2": {"xml": "UploadId"}}},
    {"name": "small part 1", "method": "PUT", "key": "small.bin", "query": {"partNumber": "1", "uploadId": "{upload_id2}"},
     "body": "tiny", "capture": {"etag3": {"header": "ETag"}}},
    {"name": "small part 2", "method": "PUT", "key": "small.bin", "query": {"partNumber": "2", "uploadId": "{upload_id2}"},
     "body": "tiny2", "capture": {"etag4": {"header": "ETag"}}},
    {"name": "complete entity too small", "method": "POST", "key": "small.bin", "query": {"uploadId": "{upload_id2}"},
     "body": "<CompleteMultipartUpload><Part><PartNumber>1</PartNumber><ETag>{etag3}</ETag></Part><Part><PartNumber>2</PartNumber><ETag>{etag4}</ETag></Part></CompleteMultipartUpload>"},
    {"name": "abort", "method": "DELETE", "key": "small.bin", "query": {"uploadId": "{upload_id2}"}},
    {"name": "list parts after abort", "method": "GET", "key": "small.bin", "query": {"uploadId": "{upload_id2}"}},

    {"name": "put tagging", "method": "PUT", "key": "top.txt", "query": {"tagging": ""}, "content_md5": true,
     "body": "<Tagging><TagSet><Tag><Key>env</Key><Value>test</Value></Tag><Tag><Key>team</Key><Value>gb</Value></Tag></TagSet></Tagging>"},
    {"name": "get tagging", "method": "GET", "key": "top.txt", "query": {"tagging": ""}},
    {"name": "get tagged", "method": "GET", "key": "top.txt"},
    {"name": "put with x-amz-tagging", "method": "PUT", "key": "tagged.txt", "body": "t",
     "headers": {"x-amz-tagging": "a=1&b=two%20words"}},
    {"name": "get tagging from header", "method": "GET", "key": "tagged.txt", "query": {"tagging": ""}},
    {"name": "delete tagging", "method": "DELETE", "key": "top.txt", "query": {"tagging": ""}},

    {"name": "delete bucket not empty", "method": "DELETE"},
    {"name": "delete objects", "method": "POST", "query": {"delete": ""}, "content_md5": true,
     "body": "<Delete><Object><Key>dir/a.txt</Key></Object><Object><Key>dir/b.bin</Key></Object><Object><Key>never-existed</Key></Object></Delete>"},
    {"name": "delete objects quiet", "method": "POST", "query": {"delete": ""}, "content_md5": true,
     "body": "<Delete><Quiet>true</Quiet><Object><Key>dir/sub/c.txt</Key></Object><Object><Key>top.txt</Key></Object><Object><Key>odd/a&amp;b.txt</Key></Object><Object><Key>odd/a&lt;b.txt</Key></Object><Object><Key>odd/ünïcødé ☃.txt</Key></Object></Delete>"},
    {"name": "delete object", "method": "DELETE", "key": "big.bin"},
    {"name": "delete missing object", "method": "DELETE", "key": "big.bin"},
    {"name": "delete rest", "method": "POST", "query": {"delete": ""}, "content_md5": true,
     "body": "<Delete><Quiet>true</Quiet><Object><Key>copy/a.txt</Key></Object><Object><Key>copy/snow.txt</Key></Object><Object><Key>tagged.txt</Key></Object></Delete>"},
    {"name": "list empty", "method": "GET", "query": {"list-type": "2"}},
    {"name": "delete bucket", "method": "DELETE"},
    {"name": "head deleted bucket", "method": "HEAD"}
  ]
}
